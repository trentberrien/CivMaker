# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Alternatively set an exact server name, provided only one joined server matches.
DISCORD_GUILD_NAME=
# Set true to get the bot online temporarily before connecting Minecraft.
DISCORD_ONLINE_ONLY=false

# Match discord.bridge-token in plugins/CivMaker/config.yml.
CIVMAKER_BRIDGE_TOKEN=
CIVMAKER_BRIDGE_URL=http://127.0.0.1:8790

SYNC_INTERVAL_SECONDS=30
ROLE_PREFIX=Civ | 
# Relative to this bot folder. Keep and back up this directory.
DATA_DIRECTORY=./data
